programa
{
	
	funcao inicio()
	{
		caracter resp
		inteiro n
		faca{
			escreva("Digite um número: ")
			leia(n)
			escreva("Qer continuar? ")
			leia(resp)
		}enquanto(resp == 'S' ou resp == 's')
			
			
	}
}
