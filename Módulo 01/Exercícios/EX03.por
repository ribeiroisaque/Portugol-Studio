programa
{
	// EX:003 - Ante e depois //
	funcao inicio()
	{
		inteiro n inteiro sus inteiro ant
		escreva("Me diga um número: ")
		leia(n)
		ant = n-1
		sus = n+1
		escreva("O antecessor de " + n + " é o valor " + ant)
		escreva("\nO sucessor de " + n + " é o valor " + sus)
		
	}
}
