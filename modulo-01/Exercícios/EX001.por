programa
{
	/* 
	   ExOO1: Programa que pergunte o nome do usuário e
	   exiba-o com uma frase de boas-vindas.
        Autor: Isaque
	*/
	
	funcao inicio()
	{
		// Declaração de variáveis
	     cadeia nome // Vai guardar o nome do usuário

	     //Entrada de dados
	     escreva("Olá! Qual é o seu nome? ")
	     leia(nome)

	     //Resultadaos finais
		escreva("Tudo bem, " + nome + "? É um grande prazer te conhecer!")
		escreva("\n")
	}
}
