programa
{
	
	funcao inicio()
	{
		inteiro num
		
		escreva("Digite um número: ")
		leia(num)
		escreva("Você acabou de digitar o valor " + num + " e ele é: ")
		se(num % 2 == 0){
			escreva("PAR")
		}senao{
			escreva("ÍMPAR")
		}
	}
}
